{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elroq-ladeoverblik",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elroq-ladeoverblik",
      "database_id": "866ee5c5-d473-4d22-9d15-76e67003931c",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "nicolajbach12@gmail.com",
    "REQUIRE_CLOUDFLARE_ACCESS": "true"
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
